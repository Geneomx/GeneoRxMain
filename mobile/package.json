{
  "name": "geneorx-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "export-logo": "node scripts/export-logo.mjs",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:android": "eas submit --platform android --profile production --latest",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "deploy:android": "eas build --platform android --profile production --non-interactive --auto-submit",
    "deploy:android:internal": "eas build --platform android --profile production --non-interactive --auto-submit-with-profile internal",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.19",
    "expo-auth-session": "~58.0.16",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.7",
    "expo-print": "~58.0.8",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.0",
    "eas-cli": "^16.0.0",
    "jest": "~30.5.2",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  }
}
