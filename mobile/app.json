{
  "expo": {
    "name": "GeneoRx",
    "slug": "geneorx",
    "scheme": "geneorx",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#16352B",
    "backgroundColor": "#F7F1E6",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geneorx.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.geneorx.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F5F7"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.geneorx.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#16352B"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://geneorx.com/api",
      "googleIosClientId": {},
      "googleAndroidClientId": {},
      "googleWebClientId": {},
      "eas": {
        "projectId": "549566bc-e300-46c2-a15e-44c62b508267"
      }
    },
    "owner": "mtayyedd"
  }
}
