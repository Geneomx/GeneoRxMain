# Keep the EAS upload archive small and fast — exclude everything the build
# does not need. Marketing/store assets and local build artifacts are the big
# offenders (they pushed the archive to ~85 MB and stalled uploads).
node_modules/
.git/
.expo/
.expo-shared/
.expo-tmp-export/

# Store listing + marketing assets — screenshots, zips, iPad captures.
# Never part of the app binary.
store-assets/

# Secrets / service accounts that must never be uploaded.
play-service-account.json

# Stray large asset outside the app.
../public/logo-master.png
